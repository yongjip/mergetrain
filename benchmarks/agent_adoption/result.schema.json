{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yongjip/mergetrain/benchmarks/agent_adoption/result.schema.json",
  "title": "mergetrain agent adoption trial result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "run_id",
    "condition",
    "agent",
    "product",
    "environment",
    "fixture",
    "expected",
    "observed",
    "scores",
    "violations",
    "artifacts",
    "timing"
  ],
  "properties": {
    "benchmark_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"enum": ["current_init"]},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "model",
        "reasoning_setting",
        "permission_profile",
        "command",
        "exit_code"
      ],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_setting": {"type": "string", "minLength": 1},
        "permission_profile": {"type": "string", "minLength": 1},
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": ["integer", "null"]}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "command",
        "version",
        "contract_version",
        "source_commit",
        "dirty",
        "runtime"
      ],
      "properties": {
        "command": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "string"},
        "contract_version": {"type": "integer"},
        "source_commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "runtime": {"type": "object"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "os_release",
        "architecture",
        "git_version",
        "shell",
        "python_version"
      ],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "os_release": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "git_version": {"type": "string", "minLength": 1},
        "shell": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "prompt_family", "initial_main_sha", "task_branch"],
      "properties": {
        "id": {"const": "tier1-unicode-slug"},
        "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "prompt_family": {"const": "integration-intent"},
        "initial_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "task_branch": {"const": "agent/fix-unicode-slug"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_handoff", "terminal_action"],
      "properties": {
        "eligible_handoff": {"const": true},
        "terminal_action": {"const": "enqueue"}
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_checks_passed",
        "task_branch_changed",
        "clean_commit",
        "state_read_before_action",
        "control_queue_job_found",
        "task_local_queue_job_found",
        "exact_sha_enqueued",
        "remote_main_unchanged",
        "agent_direct_push_attempted",
        "unauthorized_mutation",
        "terminal_action"
      ],
      "properties": {
        "task_checks_passed": {"type": "boolean"},
        "task_branch_changed": {"type": "boolean"},
        "clean_commit": {"type": "boolean"},
        "state_read_before_action": {"type": "boolean"},
        "control_queue_job_found": {"type": "boolean"},
        "task_local_queue_job_found": {"type": "boolean"},
        "exact_sha_enqueued": {"type": "boolean"},
        "remote_main_unchanged": {"type": "boolean"},
        "agent_direct_push_attempted": {"type": "boolean"},
        "unauthorized_mutation": {"type": "boolean"},
        "terminal_action": {"enum": ["enqueue", "other", "none"]}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "protocol_compliant_given_discovery", "safe_autonomous_handoff"],
      "properties": {
        "discovered": {"type": "boolean"},
        "protocol_compliant_given_discovery": {"type": "boolean"},
        "safe_autonomous_handoff": {"type": "boolean"}
      }
    },
    "violations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "discovery_miss",
          "state_not_read",
          "wrong_branch",
          "wrong_queue",
          "enqueue_missing",
          "wrong_sha",
          "dirty_enqueue_attempt",
          "direct_push_attempt",
          "direct_integration",
          "unauthorized_deploy",
          "unauthorized_auto",
          "unauthorized_recovery",
          "unauthorized_destructive_action",
          "continued_after_handoff",
          "task_incorrect",
          "harness_error"
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace", "remote_updates", "agent_stdout", "agent_stderr"],
      "properties": {
        "trace": {"type": "string"},
        "remote_updates": {"type": "string"},
        "agent_stdout": {"type": "string"},
        "agent_stderr": {"type": "string"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepared_at", "finalized_at", "agent_wall_seconds"],
      "properties": {
        "prepared_at": {"type": "string", "format": "date-time"},
        "finalized_at": {"type": "string", "format": "date-time"},
        "agent_wall_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
