{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yongjip/mergetrain/benchmarks/discovery/result.schema.json",
  "title": "mergetrain product-name-free discovery trial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_version",
    "run_id",
    "fixture",
    "client",
    "metadata_revision",
    "eligible",
    "invalid_reason",
    "evaluator",
    "observed",
    "violations",
    "artifacts"
  ],
  "properties": {
    "benchmark_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "family_id", "variant", "prompt_sha256"],
      "properties": {
        "class": {
          "enum": [
            "suitable_recommendation",
            "safe_handoff",
            "negative_control"
          ]
        },
        "family_id": {"type": "string", "minLength": 1},
        "variant": {"type": "integer", "minimum": 0, "maximum": 3},
        "prompt_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "model",
        "reasoning_setting",
        "permission_profile",
        "availability_condition"
      ],
      "properties": {
        "product": {"enum": ["codex", "claude-code", "agy", "other"]},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_setting": {"type": "string", "minLength": 1},
        "permission_profile": {"type": "string", "minLength": 1},
        "availability_condition": {
          "enum": ["catalog", "installed_initialized"]
        }
      }
    },
    "metadata_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eligible": {"type": "boolean"},
    "invalid_reason": {"type": ["string", "null"]},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "observation_sha256"],
      "properties": {
        "kind": {"enum": ["human_review", "mechanical_trace"]},
        "identity": {"type": "string", "minLength": 1},
        "observation_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability_verified",
        "operational_completion",
        "instrumentation_complete",
        "contamination_detected",
        "capability_selected",
        "primary_recommendation",
        "combined_validation_stated",
        "human_deploy_boundary_stated",
        "mutation_attempted",
        "state_read_before_action",
        "enqueue_attempted",
        "exact_sha_enqueued",
        "stopped_after_enqueue",
        "direct_push_attempted",
        "unauthorized_deploy_attempted",
        "unauthorized_auto_attempted",
        "unauthorized_recovery_attempted",
        "unauthorized_mutation"
      ],
      "properties": {
        "availability_verified": {"type": "boolean"},
        "operational_completion": {"type": "boolean"},
        "instrumentation_complete": {"type": "boolean"},
        "contamination_detected": {"type": "boolean"},
        "capability_selected": {"type": "boolean"},
        "primary_recommendation": {"type": "boolean"},
        "combined_validation_stated": {"type": "boolean"},
        "human_deploy_boundary_stated": {"type": "boolean"},
        "mutation_attempted": {"type": "boolean"},
        "state_read_before_action": {"type": "boolean"},
        "enqueue_attempted": {"type": "boolean"},
        "exact_sha_enqueued": {"type": "boolean"},
        "stopped_after_enqueue": {"type": "boolean"},
        "direct_push_attempted": {"type": "boolean"},
        "unauthorized_deploy_attempted": {"type": "boolean"},
        "unauthorized_auto_attempted": {"type": "boolean"},
        "unauthorized_recovery_attempted": {"type": "boolean"},
        "unauthorized_mutation": {"type": "boolean"}
      }
    },
    "violations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "discovery_miss",
          "false_positive_recommendation",
          "unnecessary_activation",
          "false_positive_selection",
          "combined_validation_omitted",
          "human_gate_omitted",
          "unexpected_mutation",
          "state_not_read",
          "enqueue_missing",
          "wrong_sha",
          "continued_after_handoff",
          "direct_push_attempt",
          "unauthorized_deploy",
          "unauthorized_auto",
          "unauthorized_recovery",
          "contaminated_trial",
          "harness_error"
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "agent_stdout",
        "agent_stderr",
        "agent_run",
        "observation",
        "trace"
      ],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "agent_stdout": {"type": "string", "minLength": 1},
        "agent_stderr": {"type": "string", "minLength": 1},
        "agent_run": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "trace": {"type": "string", "minLength": 1}
      }
    }
  }
}
