      "caffeinate_released_with_daemon": true
    },
    "sleep_simulation": {
      "method": "SIGSTOP of the daemon and its gate processes, then SIGCONT",
      "lock_ttl_seconds": 60,
      "suspended_seconds": 75.6,
      "while_suspended": {
        "job_status": "in_progress",
        "status_state": "running",
        "next_action": {
          "code": "unlock_wedged_runner",
          "command": "mergetrain unlock --force",
          "requires_approval": "recovery"
        },
        "competing_validate_error": "lock_held"
      },
      "next_action_after_resume": [
        [
          0.13,
          "wait_for_runner"
        ],
        [
          1.08,
          "validate_queued_jobs"
        ]
      ],
      "after_resume": {
        "status": "deployed",
        "push_status": "succeeded",
        "verify_status": "not_configured"
      }
    },
    "push_cut_off": {
      "method": "SIGKILL of the remote's receive-pack and its pre-receive hook during the push",
      "parked": {
        "status": "needs_reconcile",
        "push_status": "pending"
      },
      "status_next_action": {
        "code": "reconcile_pending_deploy",
        "command": "mergetrain reconcile --apply",
        "requires_approval": "recovery"
      },
      "daemon_log_reported_pause": true,
      "reconcile_apply_ok": true,
      "after_reconcile": {
        "status": "deployed",
        "push_status": "succeeded"
      }
    },
    "quiet_period": {
      "seconds_from_sigterm_to_exit": 10.2,
      "running_job": "deployed",
      "while_stopped": {
        "state": "waiting",
        "counts": {
          "attention": 0,
          "done": 1,
          "ready": 0,
          "running": 0,
          "waiting": 1
        },
        "next_action": "run_daemon_when_approved",
        "state_after_10s": "waiting"
      },
      "job_enqueued_while_stopped": "queued",
      "after_restart": {
        "status": "deployed",
        "push_status": "succeeded"
      }
    },
    "push_guard": {
