        },
        "paths_only": {
          "status": "blocked",
          "reason": "deploy_authorization_changed",
          "retry_while": "restored",
          "retry_replacement_auto_deploy": true,
          "note_code": "approval_execution_policy_changed"
        }
      }
    },
    "heavy_gates": {
      "docs_only": {
        "seconds": 0.9,
        "render": [
          "skipped",
          "no changed paths matched configured paths"
        ]
      },
      "render_change": {
        "seconds": 3.2,
        "render_states": [
          "active",
          "success"
        ]
      },
      "rename_out_of_scope_render_states": [
        "active",
        "success"
      ],
      "batch_docs_plus_render": {
        "statuses": [
          "deployed",
          "deployed"
        ],
        "same_deploy_sha": true,
        "render_states": [
          "active",
          "success"
        ]
      },
      "lint_and_unit_started_before_either_finished": true,
      "render_started_seconds_after_unit_finished": 0.124
